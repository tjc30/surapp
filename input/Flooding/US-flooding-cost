```python
import pandas as pd
import matplotlib.pyplot as plt

# Decadal data for US Billion-Dollar Disasters: Tropical Cyclones (Coastal Surge/Flooding) vs Inland Flooding
(1980-2024)
# Source: NOAA NCEI U.S. Billion-Dollar Weather and Climate Disasters (CPI-adjusted to 2024 dollars)
# Note: 2020-2024 represents a 5-year half-decade.

decades = ['1980–1989', '1990–1999', '2000–2009', '2010–2019', '2020–2024 (5 yrs)']

# NOAA NCEI Tropical Cyclones cost ($B CPI-adjusted)
# 1980s: 46.5, 1990s: 125.8, 2000s: 436.0, 2010s: 536.3, 2020-2024: 398.6 (Total = 1543.2)
tropical_cyclones_cost = [46.5, 125.8, 436.0, 536.3, 398.6]

# Inland Flooding cost ($B CPI-adjusted)
# 1980s: 16.2 (e.g. 1983 Western, 1986 California), 1990s: 62.4 (1993 Midwest flood was ~$44B), 2000s: 23.5, 2010s: 75.8
(2011, 2016, 2019 floods), 2020-2024: 25.1
inland_flooding_cost = [16.2, 62.4, 23.5, 75.8, 25.1]

total_flood_related = [tc + f for tc, f in zip(tropical_cyclones_cost, inland_flooding_cost)]

df_costs = pd.DataFrame({
'Decade': decades,
'Coastal_Tropical_Cyclones_Billions': tropical_cyclones_cost,
'Inland_Flooding_Billions': inland_flooding_cost,
'Total_Flood_Related_Billions': total_flood_related
})

print(df_costs)
print("Total Tropical Cyclones:", sum(tropical_cyclones_cost))
print("Total Inland Flooding:", sum(inland_flooding_cost))
print("Grand Total:", sum(total_flood_related))

# Plotting stacked bar chart
fig, ax = plt.subplots(figsize=(9, 5.5))

x = range(len(decades))
bar_width = 0.55

p1 = ax.bar(x, df_costs['Coastal_Tropical_Cyclones_Billions'], width=bar_width, label='Coastal / Tropical Cyclones
(Surge & Rain)', color='#1f77b4')
p2 = ax.bar(x, df_costs['Inland_Flooding_Billions'], width=bar_width,
bottom=df_costs['Coastal_Tropical_Cyclones_Billions'], label='Inland Flooding (Non-Tropical)', color='#2ca02c')

ax.set_ylabel('Cost in Billions of USD (CPI-Adjusted to 2024)', fontsize=11)
ax.set_title('U.S. Billion-Dollar Flood & Coastal Storm Losses by Decade (1980–2024)', fontsize=13, fontweight='bold',
pad=15)
ax.set_xticks(x)
ax.set_xticklabels(decades, fontsize=10)
ax.legend(frameon=True, loc='upper left')
ax.grid(axis='y', linestyle='--', alpha=0.5)

# Add value labels on top of bars
for i, total in enumerate(total_flood_related):
ax.annotate(f'${total:.1f}B',
xy=(i, total),
xytext=(0, 4),
textcoords="offset points",
ha='center', va='bottom', fontweight='bold', fontsize=10)

plt.tight_layout()
plt.show()

```

